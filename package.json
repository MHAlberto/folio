{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && npm run db:local && wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "dev:content": "astro dev --host 127.0.0.1",
    "build": "npm run content:validate && astro build",
    "preview": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "check": "astro check && tsc --project tsconfig.server.json --noEmit",
    "content:validate": "tsx scripts/validate-content.ts",
    "types": "wrangler types worker-configuration.d.ts --env local",
    "db:local": "wrangler d1 migrations apply folio-db --local --env local",
    "db:remote": "wrangler d1 migrations apply folio-db --remote",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:serve": "wrangler d1 migrations apply folio-db --local --env local --persist-to .wrangler/e2e && wrangler dev --env local --var ACCESS_MODE:public --ip 127.0.0.1 --port 8788 --persist-to .wrangler/e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:check": "tsx scripts/deploy-check.ts && npm run build && wrangler deploy --dry-run",
    "deploy": "tsx scripts/deploy-check.ts && npm run build && wrangler deploy",
    "deploy:locked": "tsx scripts/deploy-check.ts --locked && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.5",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/lora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.65.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "1.7.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  },
  "overrides": {
    "katex": "$katex",
    "minimatch": "^11.0.1"
  }
}
