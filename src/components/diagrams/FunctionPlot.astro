---
interface Props {
  slope?: number;
  intercept?: number;
  label?: string;
}
const { slope = 1, intercept = 0, label = 'Representación de una función afín' } = Astro.props;
const points = Array.from({ length: 101 }, (_, i) => {
  const x = (i - 50) / 10;
  return `${200 + x * 30},${140 - (slope * x + intercept) * 20}`;
}).join(' ');
---

<figure class="academic-figure">
  <svg viewBox="0 0 400 270" role="img" aria-label={label}>
    <defs>
      <clipPath id={`plot-clip-${slope}-${intercept}`}>
        <rect x="35" y="15" width="345" height="225" />
      </clipPath>
    </defs>
    <rect width="400" height="270" fill="#fff" />
    {[-4, -2, 0, 2, 4].map((x) => (
      <g>
        <path d={`M${200 + x * 30} 20V240`} stroke="#eef0eb" />
        <text x={200 + x * 30} y="258" text-anchor="middle" font-size="11" fill="#667174">
          {x}
        </text>
      </g>
    ))}
    {[-4, -2, 0, 2, 4].map((y) => (
      <g>
        <path d={`M35 ${140 - y * 20}H380`} stroke="#eef0eb" />
        <text x="24" y={144 - y * 20} text-anchor="end" font-size="11" fill="#667174">
          {y}
        </text>
      </g>
    ))}
    <path d="M35 140H380M200 20V240" stroke="#a3aea6" />
    <polyline
      points={points}
      fill="none"
      stroke="#537861"
      stroke-width="2.5"
      clip-path={`url(#plot-clip-${slope}-${intercept})`}
    />
    <text x="382" y="132" font-size="13" fill="#667174">
      x
    </text>
    <text x="208" y="25" font-size="13" fill="#667174">
      y
    </text>
  </svg>
  <figcaption>{label}. Elaboración original de Folio.</figcaption>
</figure>
