---
import { catalog } from '../../../shared/catalog';
interface Props {
  book: { title: string; subjectId: string };
  color?: string;
}
const { book, color = 'sage' } = Astro.props;
const subject = catalog.subjects.find((s) => s.id === book.subjectId)!.title;
const symbols: Record<string, string> = {
  espanol: 'Áa',
  quimica: 'H₂O',
  biologia: 'ADN',
  'historia-universal': 'XIX',
  'historia-mexico': 'MX',
  literatura: 'Aa',
  geografia: 'N / S',
  filosofia: 'φ',
};
---

<div class:list={['book-cover', color]} aria-hidden="true">
  <span class="cover-subject">Biblioteca de estudio / {subject}</span>
  <span class="cover-title">{book.title}</span>
  {book.subjectId === 'matematicas' ? (
    <svg class="cover-art" viewBox="0 0 160 130" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M14 104H149M36 120V8M18 105Q75 107 133 17M19 68H143M83 14V117" />
      <circle cx="83" cy="77" r="3" fill="currentColor" />
      <path d="M84 77H130V24" stroke-dasharray="3 4" />
      <text x="140" y="119" font-family="Georgia" font-size="13" fill="currentColor" stroke="none">
        x
      </text>
      <text x="20" y="17" font-family="Georgia" font-size="13" fill="currentColor" stroke="none">
        y
      </text>
    </svg>
  ) : book.subjectId === 'fisica' ? (
    <svg class="cover-art" viewBox="0 0 160 130" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M12 15H148M80 15V115M80 15L126 96" />
      <path d="M30 99Q80 137 135 91" stroke-dasharray="3 4" />
      <circle cx="126" cy="96" r="10" />
      <path d="M80 46Q91 46 96 55M72 122H88" />
      <circle cx="80" cy="15" r="3" fill="currentColor" />
    </svg>
  ) : (
    <svg class="cover-art" viewBox="0 0 160 130" fill="none" stroke="currentColor">
      <path d="M12 113H147M16 23H147M35 16V120" opacity=".4" />
      <text
        x="80"
        y="95"
        font-family="Georgia,serif"
        font-size={(symbols[book.subjectId]?.length ?? 0) > 2 ? 53 : 74}
        text-anchor="middle"
        fill="currentColor"
        stroke="none"
      >
        {symbols[book.subjectId]}
      </text>
    </svg>
  )}
  <span class="cover-imprint">folio / cuadernos</span>
</div>
