---
import '../styles/global.css';
import '@fontsource/lora/latin-400.css';
import '@fontsource/lora/latin-500.css';
import '@fontsource/lora/latin-400-italic.css';
import '@fontsource-variable/source-sans-3';
import Icon from '../components/ui/Icon.astro';
interface Props {
  title: string;
  section?: string;
  wide?: boolean;
  focus?: boolean;
}
const { title, section = 'Biblioteca', wide = false, focus = false } = Astro.props;
const nav = [
  ['Biblioteca', '/', 'library'],
  ['Simulacros', '/simulacros/', 'exam'],
  ['Progreso', '/progreso/', 'chart'],
  ['Repaso', '/repaso/', 'cards'],
];
---

<!doctype html>
<html lang="es" data-sidebar="closed">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Folio, tu biblioteca personal de estudio. Lecturas, preguntas y repaso en un solo lugar."
    />
    <meta name="theme-color" content="#F7F7F4" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Folio</title>
    <script is:inline>
      try {
        if (window.innerWidth > 720 && localStorage.getItem('folio:sidebar') === 'open')
          document.documentElement.dataset.sidebar = 'open';
      } catch {
        /* Navigation still works when local storage is unavailable. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <div id="menu-overlay" hidden></div>
    <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
      <div class="sidebar-heading">
        <a href="/" class="wordmark" aria-label="Folio, biblioteca">
          folio<span class="brand-dot"></span>
        </a>
        <button class="icon-button" id="menu-close" aria-label="Cerrar navegación">
          <Icon name="close" />
        </button>
      </div>
      <div class="sidebar-intro">Un espacio para aprender.</div>
      <nav>
        {nav.map(([label, href, icon]) => (
          <a
            href={href}
            class:list={['nav-item', { active: section === label }]}
            aria-current={section === label ? 'page' : undefined}
          >
            <Icon name={icon!} />
            <span>{label}</span>
          </a>
        ))}
      </nav>
      <div class="sidebar-note">
        <Icon name="book" size={22} />
        <p>
          Leer con atención.
          <br />
          Comprender a tu ritmo.
        </p>
      </div>
      <div class="sidebar-bottom">
        <a
          href="/configuracion/"
          class:list={['nav-item', { active: section === 'Configuración' }]}
        >
          <Icon name="settings" />
          <span>Configuración</span>
        </a>
        <div class="profile">
          <span class="avatar">E</span>
          <div>
            <strong id="student-name">Estudiante</strong>
            <small>Biblioteca personal</small>
          </div>
          <span class="private-dot" title="Espacio privado"></span>
        </div>
      </div>
    </aside>
    <div class="app-body">
      <header class="topbar">
        <div class="topbar-start">
          <button
            id="menu-toggle"
            class="icon-button"
            aria-controls="sidebar"
            aria-expanded="false"
            aria-label="Abrir navegación"
          >
            <Icon name="menu" />
          </button>
          <a href="/" class="wordmark" aria-label="Folio, inicio">
            folio<span class="brand-dot"></span>
          </a>
          <div class="breadcrumb">
            <span>Espacio personal</span>
            <span aria-hidden="true">/</span>
            <strong>{section}</strong>
          </div>
        </div>
        <span class="private-label">
          <span class="private-dot"></span>Espacio privado
        </span>
      </header>
      <main id="contenido" class:list={['main-content', { wide, focus }]} tabindex="-1">
        <slot />
      </main>
      <footer class="app-footer">
        <span>Folio · Biblioteca de estudio</span>
        <span>El conocimiento se construye, página a página.</span>
      </footer>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const overlay = document.querySelector<HTMLElement>('#menu-overlay');
      const sidebar = document.querySelector<HTMLElement>('#sidebar');
      const mobile = window.matchMedia('(max-width: 720px)');
      const root = document.documentElement;
      function syncNavigation() {
        const open = root.dataset.sidebar === 'open';
        if (sidebar) sidebar.inert = !open;
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute('aria-label', open ? 'Ocultar navegación' : 'Abrir navegación');
        if (overlay) overlay.hidden = !open || !mobile.matches;
      }
      syncNavigation();
      mobile.addEventListener('change', () => {
        if (mobile.matches) root.dataset.sidebar = 'closed';
        syncNavigation();
      });
      function closeMenu() {
        const wasOpen = root.dataset.sidebar === 'open';
        root.dataset.sidebar = 'closed';
        try {
          localStorage.setItem('folio:sidebar', 'closed');
        } catch {
          /* Optional preference. */
        }
        syncNavigation();
        if (wasOpen) toggle?.focus();
      }
      toggle?.addEventListener('click', () => {
        const open = root.dataset.sidebar !== 'open';
        root.dataset.sidebar = open ? 'open' : 'closed';
        try {
          localStorage.setItem('folio:sidebar', root.dataset.sidebar);
        } catch {
          /* Optional preference. */
        }
        syncNavigation();
      });
      document.querySelector('#menu-close')?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', closeMenu);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });
      import { api } from '../lib/api';
      api<{ displayName: string; textSize: string; readingWidth: string }>('/profile')
        .then((p) => {
          if (!p) return;
          const name = document.querySelector('#student-name');
          if (name) name.textContent = p.displayName;
          const avatar = document.querySelector('.avatar');
          if (avatar) avatar.textContent = p.displayName.slice(0, 1).toUpperCase();
          document.documentElement.dataset.textSize = p.textSize;
          document.documentElement.dataset.readingWidth = p.readingWidth;
        })
        .catch(() => {});
    </script>
  </body>
</html>
