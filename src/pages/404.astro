---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Página no encontrada">
  <div class="empty-state">
    <p class="eyebrow">Página no encontrada</p>
    <h1>Volvamos a la biblioteca</h1>
    <p style="margin-top:20px">La lectura o la dirección que buscas no existe en esta colección.</p>
    <a href="/" class="button">
      Abrir la biblioteca
    </a>
  </div>
</AppLayout>
