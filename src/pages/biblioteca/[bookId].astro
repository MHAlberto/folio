---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { catalog } from '../../../shared/catalog';
import { outlineForBook, syllabus } from '../../../shared/syllabus';
export function getStaticPaths() {
  return catalog.books.map((book) => ({ params: { bookId: book.id }, props: { book } }));
}
const { book } = Astro.props;
const subject = catalog.subjects.find((s) => s.id === book.subjectId)!;
const readings = catalog.topics
  .filter((t) => t.bookId === book.id)
  .sort((a, b) => a.number - b.number);
const outline = outlineForBook(book.id);
---

<AppLayout title={book.title}>
  <a class="back-link" href="/">
    <Icon name="arrow" size={15} />
    Volver a la biblioteca
  </a>
  <div class="book-detail">
    <div>
      <span class:list={['subject-marker', subject.color]}>{subject.title}</span>
      <h1>{book.title}</h1>
      <span class="badge provisional">
        {readings.some((t) => t.status === 'draft')
          ? 'Material en revisión'
          : readings.length
            ? 'Lecturas de muestra'
            : 'Material por incorporar'}
      </span>
      <p class="book-description">{book.description}</p>
      <div class="detail-meta">
        <span>{outline.length} tópicos en el temario</span>
        <span>{readings.length} lecturas disponibles</span>
      </div>
      {readings[0] ? (
        <a class="button" href={'/lectura/' + readings[0].id + '/'}>
          <Icon name="book" size={17} />
          Comenzar a leer
        </a>
      ) : (
        <p class="muted">
          El índice está preparado. Las lecturas y preguntas se incorporarán después de revisar las
          fuentes.
        </p>
      )}
      <p class="muted" style="font-size:.79rem;margin-top:18px">
        {book.author}. Las páginas corresponden a la guía que compartiste.
      </p>
    </div>
  </div>
  <div class="section-heading">
    <h2>Temario e índice</h2>
    {readings.length > 0 && (
      <a class="text-link" href={'/simulacros/?book=' + book.id}>
        Practicar este libro
        <Icon name="arrow" size={15} />
      </a>
    )}
  </div>
  {outline.map((section) => {
    const available = section.readingTopicIds.map((id) => readings.find((t) => t.id === id)!);
    return (
      <article class="topic-row">
        <span class="topic-number">{String(section.number).padStart(2, '0')}</span>
        <div>
          <h3>{section.title}</h3>
          {available.length ? (
            available.map((t) => (
              <div style="margin-top:12px">
                <a class="text-link" href={'/lectura/' + t.id + '/'}>
                  {t.title}
                  <Icon name="arrow" size={15} />
                </a>
                <span class="row-label" data-topic-status={t.id}>
                  {t.status === 'draft'
                    ? 'Borrador en revisión'
                    : 'Lectura provisional · Por comenzar'}
                </span>
              </div>
            ))
          ) : (
            <span class="row-label muted">Pendiente de incorporar</span>
          )}
        </div>
        <div class="topic-actions">
          <small>p. {section.page}</small>
        </div>
      </article>
    );
  })}
  <p class="muted" style="font-size:.81rem;margin-top:25px">
    {syllabus.source.note}
  </p>
</AppLayout>
<script>
  import { api } from '../../lib/api';
  api<{ topicId: string; status: string }[]>('/progress')
    .then((rows) => {
      for (const p of rows) {
        const el = document.querySelector('[data-topic-status="' + CSS.escape(p.topicId) + '"]');
        if (el) el.textContent = p.status === 'completed' ? 'Lectura completada' : 'En lectura';
      }
    })
    .catch(() => {});
</script>
